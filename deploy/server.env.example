# Copy to /etc/callbreak/server.env, set ownership root:callbreak and chmod 640.
FIREBASE_AUTH_ENABLED=true
REQUIRE_AUTH=false
GOOGLE_APPLICATION_CREDENTIALS=/etc/callbreak/firebase-service-account.json

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
PAYMENT_LEDGER_FILE=/opt/callbreak-server/data/razorpay-payments.jsonl
COIN_LEDGER_FILE=/opt/callbreak-server/data/coin-wallet.jsonl
